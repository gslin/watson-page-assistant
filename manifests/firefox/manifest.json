{
  "manifest_version": 3,
  "name": "Watson Page Assistant",
  "version": "0.20260930.0",
  "description": "AI-powered page analysis using OpenAI API",
  "permissions": ["activeTab", "storage"],
  "background": {
    "scripts": ["background/service-worker.js"]
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Watson Page Assistant Settings",
    "theme_icons": [
      { "light": "icons/icon-16-light.png", "dark": "icons/icon-16.png", "size": 16 },
      { "light": "icons/icon-32-light.png", "dark": "icons/icon-32.png", "size": 32 }
    ]
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Watson Page Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "open_at_install": false
  },
  "commands": {
    "open-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Y"
      },
      "description": "Open Watson Page Assistant"
    },
    "open-profile-1": {
      "description": "Open assistant with shortcut slot 1"
    },
    "open-profile-2": {
      "description": "Open assistant with shortcut slot 2"
    },
    "open-profile-3": {
      "description": "Open assistant with shortcut slot 3"
    },
    "open-profile-4": {
      "description": "Open assistant with shortcut slot 4"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common/readability.min.js", "content/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup/popup.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "watson-page-assistant@example.com"
    }
  }
}
